              "ui__appearance__face": "Face like an Akita Inu",
              "ui__appearance__face_sub": "grandma clearly hung out with some noble dogs"
            },
            "photos": {
              "ps_rug": {
                "src": "/images/photo-set/ps_rug.webp",
