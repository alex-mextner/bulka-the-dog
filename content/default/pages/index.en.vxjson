            "copy": {
              "skills__title": "Skills",
              "skills__intro": "In two weeks at home I learned a bunch of commands.",
              "ui__skills__commands_title": "Commands I know",
              "skills__explanation": "I don't get what's so hard about it: you just do what you're asked, and then you get a treat."
            },
            "photos": {
              "ps_paw": {
                "src": "/images/photo-set/ps_paw.webp",
                "thumbSrc": "/images/photo-set/thumbs/ps_paw.webp",
                "alt": "Giving my paw",
                "caption": "'Paw' is the only command I fully agree with"
              }
