          }
        },
        {
          "type": "Habits",
          "props": {
            "id": "bulka-habits",
            "copy": {
              "habits__title": "Household habits"
            },
            "items": [
              {
                "id": "bathroom",
                "emoji": "🚽",
                "title": "Bathroom",
                "body": "I figured out that you're supposed to go to the bathroom outside on my second day living at home, and since then I've never peed indoors.",
                "photo": {
                  "src": "/images/photo-set/ps_portrait.webp",
                  "thumbSrc": "/images/photo-set/thumbs/ps_portrait.webp",
                  "alt": "Looking at the camera",
                  "caption": "Yes, I'm pretty. Thanks for noticing"
                },
                "secondaryPhoto": {
                  "src": "/images/dog_apartment.webp",
                  "alt": "At the vet, Lena hugging me",
                  "caption": "At the vet. Lena playing emergency"
                },
                "showPhotos": false
              },
              {
                "id": "walks",
                "emoji": "🚶",
                "title": "Walks",
                "body": "I get walked twice a day: at 10 in the morning and 10 at night. I prefer being at home, so I'm happy to do my business and head back, but I can also keep you company for the whole day and go with you to the bank, to the beauty salon, to a restaurant, or to visit friends. I'll quietly lie down next to you and sprawl out.",
                "photo": {
                  "src": "/images/photo-set/ps_walk.webp",
                  "thumbSrc": "/images/photo-set/thumbs/ps_walk.webp",
                  "alt": "Lena walking me down a park path",
                  "caption": "Morning park — mine. Lena just holds the leash"
                },
                "secondaryPhoto": {
                  "src": "/images/dogs_public.webp",
                  "alt": "Me in the park with another dog and two people",
                  "caption": "In the park with friends"
                },
                "showPhotos": true
              },
              {
                "id": "behavior",
                "emoji": "🐕",
                "title": "Behavior",
                "body": "I won't jump on other dogs or fight with them — I didn't find myself in a dumpster, after all. I can walk calmly both on a leash and off: I'll walk around you and sniff the flowers.",
                "photo": {
                  "src": "/images/dogs_public.webp",
                  "alt": "Me in the park with another dog and two people",
                  "caption": "In the park with friends"
                },
                "secondaryPhoto": {
                  "src": "/images/photo-set/ps_family.webp",
                  "thumbSrc": "/images/photo-set/thumbs/ps_family.webp",
                  "alt": "Family photo: Lena, a guy, two cats, and me",
                  "caption": "Everyone's holding cats. I lie here and watch the show"
                },
                "showPhotos": true
              },
              {
                "id": "car",
                "emoji": "🚗",
                "title": "In the car",
                "body": "I can jump into the car on my own and ride calmly in the back seat. I have a superpower — I never get carsick!",
                "photo": {
                  "src": "/images/bulka_car_walk.webp",
                  "thumbSrc": "/images/bulka_car_walk_thumb.webp",
                  "alt": "Me with Lena by the car, already pulling the leash toward business",
                  "caption": "Cars don't scare me. I have places to be"
                },
                "secondaryPhoto": {
                  "src": "/images/lena_dogs.webp",
                  "alt": "Me with Lena in the car, Lena smiling on a selfie",
                  "caption": "Riding in the car. I don't get carsick — superpower"
                },
                "showPhotos": true
              },
              {
                "id": "home",
                "emoji": "🏠",
                "title": "At home",
                "body": "At home I mostly sleep. Lena doesn't let me climb on the couch, which I of course consider discrimination. If I happen to be left alone all day, I'll just keep sleeping. I don't understand dogs who are afraid to be home alone — quite the opposite, it's great, you can enjoy the silence.",
                "photo": {
                  "src": "/images/bulka_tv.webp",
                  "alt": "I'm sitting on the rug in front of the TV",
                  "caption": "Sitting. Waiting for the \"paw\" command"
                },
                "secondaryPhoto": {
                  "src": "/images/photo-set/ps_balcony_sun.webp",
                  "thumbSrc": "/images/photo-set/thumbs/ps_balcony_sun.webp",
                  "alt": "Lying on the balcony in the sun",
                  "caption": "Balcony, sun, me. Classic"
                },
                "showPhotos": true
              },
              {
                "id": "food",
                "emoji": "🍖",
                "title": "Food",
                "body": "I eat dry food twice a day. And treats. I love dog pâté and cheese.",
                "photo": {
                  "src": "/images/photo-set/ps_rug.webp",
                  "thumbSrc": "/images/photo-set/thumbs/ps_rug.webp",
                  "alt": "Lying on the rug at home",
                  "caption": "This is my rug. It's in the constitution"
                },
                "secondaryPhoto": {
                  "src": "/images/photo-set/ps_ball.webp",
                  "thumbSrc": "/images/photo-set/thumbs/ps_ball.webp",
                  "alt": "Me with a tennis ball",
                  "caption": "Ball's right there, just in case"
                },
                "showPhotos": false
              },
              {
                "id": "cats",
                "emoji": "🐱",
                "title": "Living with cats",
                "body": "Right now I live with two cats. Honestly, I don't even notice them: they just walk around, what do I care.",
                "photo": {
                  "src": "/images/photo-set/ps_cat_balcony.webp",
                  "thumbSrc": "/images/photo-set/thumbs/ps_cat_balcony.webp",
                  "alt": "Sniffing a cat under the table on the balcony",
                  "caption": "We live together. We worked it out"
                },
                "secondaryPhoto": {
                  "src": "/images/dog_home.webp",
                  "alt": "I'm lying at home, cats are sitting on the windowsill",
                  "caption": "Cats do their things, I do mine"
                },
                "showPhotos": true
              }
            ]
          }
        },
        {
          "type": "Skills",
          "props": {
