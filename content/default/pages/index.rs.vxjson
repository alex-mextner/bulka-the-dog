        {
          "type": "Questions",
          "props": {
            "id": "bulka-faq",
            "copy": {
              "faq__title": "Šta me obično pitaju",
              "faq__subtitle": "Niste našli svoje pitanje? Pišite Leni direktno — ona kuca brže od mene.",
              "faq__banner_title": "Ako ne ispadne kako treba, Lena me uzima nazad.",
              "faq__banner_subtitle": "Bez ljutnje, bez uslova, bez «probajte još mesec dana»."
            },
            "items": [
              {
                "id": "kids",
                "question": "Jesi okej s decom?",
                "answer": "Lena me sa decom nije testirala, neću da lažem. Ali ne skačem, ne ujedam, druge pse na ulici zaobilazim — osnovni paket postoji. Hoćete da budete sigurni — dođite s detetom u goste, vidimo uživo."
              },
              {
                "id": "rental",
                "question": "Ja sam u iznajmljenom stanu, sme li to?",
                "answer": "Sme. Tiha sam, stvari ne kvarim — Lena će potvrditi. Ako gazda traži depozit za psa — Lena je spremna da popriča s njim i pomogne da objasni da nisam pas zbog kog se prelepljuju tapete."
              },
              {
                "id": "monthly_cost",
                "question": "Koliko ću trošiti mesečno?",
                "answer": "Hrana i redovan odlazak kod veterinara — pošto dovršimo crva. Crva dolečujem na Leninu, vas se to ne tiče. Ukratko, po novcu sam kao bilo koji prosečan pas — nikakvih iznenađenja tipa «evo vam još jedna bolest»."
              },
              {
                "id": "guarantee",
                "question": "Šta ako ne ispadne?",
                "answer": "Lena me uzima nazad. Besplatno, bez ljutnje, bez uslova."
              },
              {
                "id": "other_pets",
                "question": "Šta s drugim psima i mačkama?",
                "answer": "S dve mačke živim baš sad i skoro ih i ne primećujem: hodaju tuda i hodaju, meni šta. S drugim psima se ne kačim i ne tučem — ako naiđe nametljivi mužjak, jednostavno se okrenem. Nije moj žanr."
              },
              {
                "id": "health",
                "question": "Jesi zdrava?",
                "answer": "Da, ali ima detalja. Srčani crv — leči se, terapija već ide. Metak kod kičme leži i nikome ne smeta. Šapa kriva — dodaje šarma, kaže doktor. Detalji su u sekciji «Zdravlje», tamo sve piše: i metak, i šapa, i crv."
              },
              {
                "id": "remote",
                "question": "Nisam u Beogradu. Može na daljinu?",
                "answer": "Zavisi koliko daleko. Beograd, Novi Sad i okolina — okej: Lena želi povremeno da me obilazi, pa mora da me dohvati. Ostatak EU — da se čujemo, smislićemo nešto. Drugi kontinent, viza, let preko pola sveta — iskreno: teško."
              },
              {
                "id": "deadline",
                "question": "Kad treba da se odlučim?",
                "answer": "Lena odlazi zimi, tačan datum još pluta. Niko vam ne stoji nad dušom — ali što se pre odlučimo, svima je mirnije, pre svega meni."
              }
            ]
          }
        },
