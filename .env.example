# Public envs (Vite). Anything prefixed with VITE_ is exposed to client code.
# For real secrets use the server side, NOT this file.

# Builder.io public API key (used by the existing site setup).
VITE_PUBLIC_BUILDER_KEY=__BUILDER_PUBLIC_KEY__

# Server-side ping demo.
PING_MESSAGE="ping pong"

# --- Donations panel (off by default) ---
# Set to "1" or "true" to render <DonationsPanel/> in the page.
# When unset/"0"/anything else — component returns null, nothing is rendered.
# VITE_ENABLE_DONATIONS=1

# Donation page the CTA opens in a new tab. If unset, the button logs a
# console warning and does nothing — wire this before flipping the flag on.
# VITE_DONATION_URL=https://example.org/donate
