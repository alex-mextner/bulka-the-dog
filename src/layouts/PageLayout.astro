---
import '../../client/global.css';
import { htmlLanguage, safePublicUrl } from '../../client/cms/content-model';
import { publicEnvironment } from '../generated/public-environment';

interface Props {
  title?: string;
  description?: string;
  locale?: 'ru' | 'rs' | 'en';
  socialImage?: string;
  alternatives?: { language: string; href: string }[];
}
const { title = 'Bulka', description = '', locale = 'ru', socialImage = '/og-image.jpg', alternatives = [] } = Astro.props;
const site = Astro.site || Astro.url.origin;
const canonical = new URL(Astro.url.pathname, site);
const image = new URL(safePublicUrl(socialImage) ? socialImage : '/og-image.jpg', site);
const ogLocale = { ru: 'ru_RU', rs: 'sr_RS', en: 'en_US' }[locale];
---
<!doctype html>
<html lang={htmlLanguage(locale)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <meta name="theme-color" content="#f97316" />
    <script is:inline>
      (() => {
        try {
          const apple = /iP(ad|hone|od)/.test(navigator.userAgent) ||
            (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
          if (apple) document.documentElement.dataset.appleTouch = 'true';
          if (matchMedia('(prefers-color-scheme: dark)').matches) document.documentElement.classList.add('dark');
        } catch {}
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternatives.map(({ language, href }) => <link rel="alternate" hreflang={htmlLanguage(language)} href={new URL(href, site)} />)}
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.ico" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={locale === 'ru' ? 'Булка' : 'Bulka'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {publicEnvironment.enableAnalytics && <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id="00a875c6-2278-4396-bf41-d391d0ce02d1"></script>}
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'Article', headline: title,
      description, inLanguage: htmlLanguage(locale), author: { '@type': 'Person', name: locale === 'ru' ? 'Лена' : 'Lena' },
      image: image.href, mainEntityOfPage: { '@type': 'WebPage', '@id': canonical.href },
    }).replaceAll('<', '\\u003c')} />
  </head>
  <body>
    <slot />
    <noscript><nav aria-label={{ ru: 'Мои языки', rs: 'Moji jezici', en: 'My languages' }[locale]} style="padding:1rem;text-align:center">{alternatives.map(({ language, href }) => <a href={href} style="margin:0 .5rem">{htmlLanguage(language).toUpperCase()}</a>)}</nav></noscript>
  </body>
</html>
